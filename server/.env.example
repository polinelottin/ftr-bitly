PORT=
# Local / migrations: omita ou use development. Em deploy, use production e configure o R2 abaixo.
NODE_ENV=development
DATABASE_URL=

# Obrigatórias em produção: CSV é enviado ao R2 e GET /url-shortner/export retorna JSON { url, filename }.
# Em desenvolvimento/teste, omita todas para receber o CSV inline no corpo da resposta.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY_ID=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKET=""
# URL pública do bucket (domínio R2 customizado ou r2.dev), sem barra final ou com — ambos funcionam.
CLOUDFLARE_PUBLIC_URL=""